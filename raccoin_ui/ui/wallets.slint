import { ListView, HorizontalBox, CheckBox, ComboBox, Button, VerticalBox, ScrollView , LineEdit} from "std-widgets.slint";
import { Badge, ElidingText, TableHeader, HeaderCell, TextCell, MonoTextCell, CurrencyIcon, Cell } from "common.slint";
import { Facade } from "global.slint";
import { UiBalanceForWallet, UiWalletSource, UiWallet } from "structs.slint";

component HoldingsButton inherits TouchArea {
    in property <[UiBalanceForWallet]> balances;

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && balances.length > 0) {
            popup.show();
        }
    }

    states [
        disabled when balances.length == 0: {
            holdings-text.color: gray;
        }
        hovered when root.has-hover: {
            holdings-background.background: #1e1e1e;
            holdings-background.border-color: #6e6e6e;
        }
    ]

    VerticalLayout {
        holdings-background := Rectangle {
            border-radius: 5px;
            border-color: #3e3e3e;
            border-width: 1px;

            HorizontalLayout {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                holdings-text := ElidingText {
                    text: "Holdings";
                }
            }

            popup := PopupWindow {
                width: 300px;
                height: balances-list.preferred-height;
                x: 0 - 300px - 5px;
                y: 0;
                Rectangle {
                    z: 100;
                    background: #000000;
                    border-radius: 5px;
                    border-color: #3e3e3e;
                    border-width: 1px;

                    balances-list := VerticalLayout {
                        padding-top: 5px;
                        padding-bottom: 5px;
                        padding-left: 1px;
                        padding-right: 1px;
                        spacing: 5px;

                        header := TableHeader {
                            separator: false;
                            horizontal-padding-left: 7px;
                            horizontal-padding-right: 7px;
                            HeaderCell { text: "Currency"; }
                            HeaderCell { text: "Quantity"; }
                        }

                        for balance[index] in balances: Rectangle {
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 9px;
                                spacing: header.item-spacing;

                                Cell {
                                    CurrencyIcon {
                                        cmc-id: balance.currency-cmc-id;
                                    }
                                    ElidingText {
                                        text: balance.currency;
                                    }
                                }
                                MonoTextCell { text: balance.balance; horizontal-alignment: left; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Presentation of a single wallet row, including the grip handle that starts a drag.
// Reordering itself (the drop target and insertion indicator) is handled by the list.
component WalletItem inherits Rectangle {
    in property <UiWallet> wallet;
    in property <int> wallet-index;

    callback transactions-clicked(int);
    callback add-source-requested(int);
    // Fired when the grip handle begins / ends a drag, so the list can track it.
    callback drag-started();
    callback drag-ended();

    property <bool> is-expanded: wallet.expanded;

    border-width: 1px;
    border-radius: 5px;
    border-color: #3e3e3e;
    background: #212121;

    states [
        hovered when header-touch.has-hover: {
            background: #4564;
        }
        expanded when root.is-expanded: {
            background: #2e2e2e;
        }
    ]

    VerticalLayout {
        HorizontalLayout {
            spacing: 0px;

            drag-handle := DragArea {
                width: 28px;
                allow-move: true;
                data: Facade.wallet-drag-data(root.wallet-index);

                changed dragging => {
                    if (self.dragging) {
                        root.drag-started();
                    }
                }
                drag-finished(action) => {
                    root.drag-ended();
                }

                Image {
                    source: @image-url("icons/grip-vertical.svg");
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    opacity: drag-handle.dragging ? 1.0 : 0.4;
                }
            }

            header-touch := TouchArea {
                horizontal-stretch: 1;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.is-expanded = !root.is-expanded;
                        Facade.set-wallet-expanded(root.wallet-index, root.is-expanded);
                    }
                }

                HorizontalBox {
                    CheckBox {
                        checked: root.wallet.enabled;
                        text: root.wallet.name;
                        toggled => { Facade.set-wallet-enabled(root.wallet-index, self.checked); }
                    }
                    Badge {
                        text: "\{root.wallet.transaction-count} transactions";
                        interactive: true;
                        clicked => { root.transactions-clicked(root.wallet-index); }
                    }
                    Rectangle {}
                    HoldingsButton {
                        balances: Facade.balances-for-wallet(root.wallet-index);
                    }
                    Button {
                        icon: @image-url("icons/trash-2.svg");
                        text: "Remove Wallet";
                        clicked => { Facade.remove-wallet(root.wallet-index); }
                    }
                }
            }
        }

        sources-frame := Rectangle {
            height: sources-layout.height;
            clip: true;
            background: #1e1e1e;

            border-radius: 5px;
            border-width: 1px;
            border-color: #3e3e3e;

            sources-layout := VerticalBox {
                states [
                    expanded when root.is-expanded: {
                        height: sources-layout.preferred-height;
                    }
                    collapsed when !root.is-expanded: {
                        height: 0px;
                    }
                ]

                animate height { duration: 100ms; }

                for source[source_index] in root.wallet.sources: HorizontalBox {
                    padding: 0;
                    CheckBox {
                        checked: source.enabled;
                        text: source.name;
                        opacity: root.wallet.enabled ? 1.0 : 0.5;
                        toggled => { Facade.set-source-enabled(root.wallet-index, source_index, self.checked); }
                    }
                    ElidingText {
                        text: source.path;
                    }
                    Rectangle { width: 1px; }
                    Badge {
                        text: "\{source.transaction-count} transactions";
                        opacity: 0.5;
                    }
                    Rectangle {}
                    ComboBox {
                        model: Facade.source-types;
                        horizontal-stretch: 0;
                        current-value: source.source_type;
                        enabled: false;
                    }
                    Button {
                        icon: @image-url("icons/refresh-cw.svg");
                        enabled: source.can-sync;
                        opacity: self.enabled ? 1.0 : 0.3;
                        clicked => { Facade.sync-source(root.wallet-index, source_index); }
                    }
                    Button {
                        icon: @image-url("icons/trash-2.svg");
                        clicked => { Facade.remove-source(root.wallet-index, source_index); }
                    }
                }
                HorizontalBox {
                    alignment: end;
                    padding-left: 0;
                    padding-right: 0;
                    padding-bottom: 0;

                    Button {
                        text: "Add Source";
                        clicked => { root.add-source-requested(root.wallet-index); }
                    }
                }
            }
        }
    }
}

export component Wallets inherits ScrollView {
    in property <[UiWallet]> wallets: Facade.wallets;

    callback wallet-transactions-clicked(int);
    callback add-source-requested(int);

    // Drag state shared across all wallet rows.
    private property <int> dragged-index: -1;
    private property <int> drop-target-index: -1;
    private property <length> auto-scroll-speed: 0px;

    VerticalBox {
        padding-left: 17px;
        padding-right: 17px;

        // Keeps scrolling while a drag is held near a viewport edge (a Timer is needed
        // because the drag callbacks only fire while the pointer actually moves).
        Timer {
            interval: 16ms;
            running: root.dragged-index >= 0 && root.auto-scroll-speed != 0px;
            triggered => {
                root.viewport-y = clamp(
                    root.viewport-y - root.auto-scroll-speed,
                    min(0px, root.visible-height - root.viewport-height),
                    0px);
            }
        }

        for wallet[wallet-index] in wallets: drop-area := DropArea {
            can-drop(event) => {
                // Scroll the list when the pointer nears the top/bottom edge of the viewport.
                root.auto-scroll-speed =
                    (self.absolute-position.y + event.position.y) < (root.absolute-position.y + 40px) ? -12px
                    : (self.absolute-position.y + event.position.y) > (root.absolute-position.y + root.visible-height - 40px) ? 12px
                    : 0px;

                // Insert above this wallet when hovering its top half, below otherwise.
                root.drop-target-index = event.position.y < self.height / 2
                    ? wallet-index
                    : wallet-index + 1;
                // Always accept so the drag keeps clear feedback while moving; a drop into
                // a gap adjacent to the dragged wallet is a no-op in dropped().
                return DragAction.move;
            }
            dropped(event) => {
                // Skip the no-op gaps directly above and below the dragged wallet.
                if (root.drop-target-index != root.dragged-index
                    && root.drop-target-index != root.dragged-index + 1) {
                    Facade.move-wallet(root.dragged-index, root.drop-target-index);
                }
                root.dragged-index = -1;
                root.drop-target-index = -1;
                root.auto-scroll-speed = 0px;
                return DragAction.move;
            }

            WalletItem {
                wallet: wallet;
                wallet-index: wallet-index;
                drag-started => { root.dragged-index = wallet-index; }
                drag-ended => {
                    root.dragged-index = -1;
                    root.drop-target-index = -1;
                    root.auto-scroll-speed = 0px;
                }
                transactions-clicked(index) => { root.wallet-transactions-clicked(index); }
                add-source-requested(index) => { root.add-source-requested(index); }
            }

            // Insertion indicator: a line centered in the 8px gap above this wallet.
            if root.drop-target-index == wallet-index: Rectangle {
                z: 10;
                x: 0;
                y: -5.5px;
                width: parent.width;
                height: 3px;
                border-radius: 1.5px;
                background: #6e9eff;
            }
            // Insertion indicator below the last wallet (the final gap).
            if wallet-index == wallets.length - 1 && root.drop-target-index == wallet-index + 1: Rectangle {
                z: 10;
                x: 0;
                y: parent.height + 2.5px;
                width: parent.width;
                height: 3px;
                border-radius: 1.5px;
                background: #6e9eff;
            }
        }

        HorizontalBox {
            alignment: end;
            wallet-name := LineEdit {
                placeholder-text: "New Wallet Name";
                enabled: Facade.portfolio.file-name != "";
                accepted => {
                    if (wallet-name.text != "") {
                        Facade.add-wallet(wallet-name.text);
                        wallet-name.text = "";
                    }
                }
            }
            Button {
                text: "Add Wallet";
                enabled: wallet-name.text != "";
                clicked => {
                    Facade.add-wallet(wallet-name.text);
                    wallet-name.text = "";
                }
            }
        }

        Rectangle {}
    }
}
